rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // any signed-in user can see profiles, but only edit their own
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }
    // only the two members can read or write a chat
    match /chats/{chatId} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.members);
      allow write: if request.auth != null && chatId.split('_').hasAny([request.auth.uid]);
      match /messages/{messageId} {
        allow read, write: if request.auth != null && chatId.split('_').hasAny([request.auth.uid]);
      }
    }
  }
}
